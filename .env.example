
# Environment Setup
APP_ENV=dev

# AWS Credentials (never commit real values)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=eu-west-1

# AWS S3 Configuration
S3_BUCKET=your-bucket-name

# AWS Glue Configuration (optional)
GLUE_DATABASE=your_glue_database

# Data Paths
DATA_BASE_PATH=/opt/lakehouse/data

# Spark Configuration (optional - overrides YAML settings)
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SHUFFLE_PARTS=4
SPARK_LOG_LEVEL=WARN

# Logging
LOG_LEVEL=INFO

# Configuration Directory
CONFIG_DIR=/opt/lakehouse/config
